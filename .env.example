# Server Configuration
HOST=127.0.0.1
PORT=8000

# Ollama Daemon Connection
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Secret API Key (Generate a random secure key for production)
API_KEY=replace-with-a-secure-random-api-key

# Allowed CORS Origins (comma separated, or * for open access)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
