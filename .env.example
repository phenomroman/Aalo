# Server Configuration
HOST=127.0.0.1
PORT=8000

# Ollama Daemon Connection
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Secret API Key(s) for remote authentication
# Specify a single key with API_KEY or multiple comma-separated keys with API_KEYS (or both)
API_KEY=replace-with-a-secure-random-api-key
# API_KEYS=user1-secret-key,user2-secret-key

# Allowed CORS Origins (comma separated, or * for open access)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# System Prompt
SYSTEM_PROMPT = "Your customized system prompt goes here."